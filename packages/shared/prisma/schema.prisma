// Nexus — Day 1 schema draft.
// Not migrated yet: Postgres isn't running until Day 3 (infra setup).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id             String   @id @default(uuid())
  name           String   @unique
  baseUrl        String
  healthCheckUrl String
  createdAt      DateTime @default(now())

  routes  Route[]
  apiKeys ApiKey[]
}

model RateLimitConfig {
  id                String  @id @default(uuid())
  requestsPerWindow Int
  windowSeconds     Int
  routes            Route[]
}

model Route {
  id                String           @id @default(uuid())
  service           Service          @relation(fields: [serviceId], references: [id])
  serviceId         String
  pathPattern       String
  method            String
  authType          String // "jwt" | "apiKey" | "none"
  rateLimitConfig   RateLimitConfig? @relation(fields: [rateLimitConfigId], references: [id])
  rateLimitConfigId String?
  createdAt         DateTime         @default(now())
}

model ApiKey {
  id        String    @id @default(uuid())
  keyHash   String    @unique
  service   Service   @relation(fields: [serviceId], references: [id])
  serviceId String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("developer")
  createdAt    DateTime @default(now())
}

model Job {
  id          String     @id @default(uuid())
  type        String
  payload     Json
  status      String     @default("queued") // queued | active | completed | failed
  priority    Int        @default(0)
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  runAt       DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  logs       JobLog[]
  dlqEntries DlqEntry[]
}

model JobLog {
  id        String   @id @default(uuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  status    String
  message   String?
  createdAt DateTime @default(now())
}

model DlqEntry {
  id            String   @id @default(uuid())
  job           Job      @relation(fields: [jobId], references: [id])
  jobId         String
  failureReason String
  movedAt       DateTime @default(now())
}